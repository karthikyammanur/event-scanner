# Copy to .env for local runs. .env is gitignored and must never be committed.
# In GitHub Actions these come from repository secrets instead.

# Extraction (Gemini). Without it the tool falls back to deterministic
# filtering only.
GEMINI_API_KEY=

# Broad discovery (Tavily). Without it this source is skipped, others still
# run. Tavily's free tier is 1,000 credits/month, no card required.
TAVILY_API_KEY=

# Gmail SMTP delivery. Use an app password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where the digest goes. Defaults to GMAIL_USER when unset.
DIGEST_TO=
